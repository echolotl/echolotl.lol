{
  "name": "app",
  "version": "1.0.50",
  "module": "src/index.js",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build --compile --minify-whitespace --minify-syntax --target bun-linux-x64 --outfile server src/index.ts",
    "start": "bun run ./src/index.ts",
    "lint": "oxlint .",
    "format": "oxfmt --write ."
  },
  "dependencies": {
    "@echolotl/picross": "workspace:*",
    "@echolotl/types": "workspace:*",
    "@elysiajs/cors": "^1.4.2",
    "elysia": "latest",
    "elysia-rate-limit": "^4.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "bun-types": "latest",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "shiki": "^4.3.1"
  }
}
