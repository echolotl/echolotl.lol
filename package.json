{
  "name": "echolotl-lol",
  "private": true,
  "packageManager": "bun@1.4.5",
  "workspaces": [
    "backend",
    "frontend",
    "packages/types",
    "packages/picross"
  ],
  "trustedDependencies": [
    "@parcel/watcher",
    "better-sqlite3",
    "esbuild"
  ],
  "scripts": {
    "dev": "bun run --bun --filter @echolotl/frontend --filter @echolotl/backend --parallel dev",
    "dev:frontend": "bun run --bun --filter @echolotl/frontend dev",
    "dev:backend": "bun run --bun --filter @echolotl/backend dev",
    "build": "bun run --bun --filter @echolotl/frontend --filter @echolotl/backend build",
    "build:frontend": "bun run --bun --filter @echolotl/frontend build",
    "build:backend": "bun run --bun --filter @echolotl/backend build",
    "lint": "bun run --bun --filter @echolotl/frontend --filter @echolotl/backend lint",
    "format": "bun run --bun --filter @echolotl/frontend --filter @echolotl/backend format"
  }
}
